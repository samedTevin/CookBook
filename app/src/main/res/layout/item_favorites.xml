<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    android:layout_gravity="center_horizontal"
    android:layout_margin="10dp"
    android:backgroundTint="@color/white">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp">
        <ImageView
            android:id="@+id/ivFoodPhoto"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:src="@drawable/hamburger"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.google.android.material.chip.Chip
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Video"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:clickable="false"
            android:focusable="false"
            app:chipBackgroundColor="@color/primary"
            app:chipCornerRadius="12dp"
            app:chipIcon="@drawable/baseline_play_circle_24"
            app:chipIconTint="@color/white"
            app:chipStrokeWidth="0dp"
            android:elevation="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginStart="5dp"
            />

        <TextView
            android:id="@+id/tvFoodName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Food Name"
            android:layout_marginTop="10dp"
            android:textSize="30sp"
            android:fontFamily="@font/poppins_semibold"
            app:layout_constraintTop_toBottomOf="@id/ivFoodPhoto"
            app:layout_constraintStart_toStartOf="parent"/>
        
        <ImageButton
            android:id="@+id/ibHeart"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/outline_favorite_24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivFoodPhoto"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/white"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/tvCountry"
            android:layout_marginTop="30dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Turkish"
            android:textSize="20sp"
            android:fontFamily="@font/inter"
            app:layout_constraintTop_toBottomOf="@id/tvFoodName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvCategory"/>

        <TextView
            android:id="@+id/tvCategory"
            android:layout_marginTop="30dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Seafood"
            android:textSize="20sp"
            android:fontFamily="@font/inter"
            app:layout_constraintTop_toBottomOf="@id/tvFoodName"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvCountry"/>




    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>