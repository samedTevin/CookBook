<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_margin="10dp"

    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"

    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/card_background">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerLayout"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:visibility="gone"
            app:shimmer_auto_start="true"
            app:shimmer_base_alpha="0.6"
            app:shimmer_duration="1200"
            app:shimmer_highlight_alpha="1.0">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp">

                <!-- Fake image -->

                <View
                    android:id="@+id/skeletonImage"
                    android:layout_width="0dp"
                    android:layout_height="200dp"
                    android:background="@drawable/bg_skeleton"

                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />


                <!-- Fake title -->

                <View
                    android:id="@+id/skeletonTitle"
                    android:layout_width="200dp"
                    android:layout_height="22dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_skeleton"

                    app:layout_constraintTop_toBottomOf="@id/skeletonImage"
                    app:layout_constraintStart_toStartOf="parent" />


                <!-- Fake country -->

                <View
                    android:id="@+id/skeletonCountry"
                    android:layout_width="100dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_skeleton"

                    app:layout_constraintTop_toBottomOf="@id/skeletonTitle"
                    app:layout_constraintStart_toStartOf="parent" />


                <!-- Fake category -->

                <View
                    android:id="@+id/skeletonCategory"
                    android:layout_width="100dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_skeleton"

                    app:layout_constraintTop_toBottomOf="@id/skeletonTitle"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.facebook.shimmer.ShimmerFrameLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:padding="16dp">


            <ImageView
                android:id="@+id/ivFoodPhoto"

                android:layout_width="0dp"
                android:layout_height="200dp"

                android:scaleType="centerCrop"

                android:src="@drawable/hamburger"

                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>


            <TextView
                android:id="@+id/tvFoodName"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_marginTop="12dp"
                android:layout_marginEnd="8dp"

                android:text=""

                android:textColor="@color/text_primary"

                android:textSize="22sp"

                android:fontFamily="@font/poppins_semibold"

                android:maxLines="1"
                android:ellipsize="end"


                app:layout_constraintTop_toBottomOf="@id/ivFoodPhoto"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/ibHeart"/>


            <com.airbnb.lottie.LottieAnimationView

                android:id="@+id/ibHeart"

                android:layout_width="50dp"
                android:layout_height="50dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                app:lottie_autoPlay="false"
                app:lottie_loop="false"
                app:lottie_rawRes="@raw/heart_button"


                app:layout_constraintTop_toTopOf="@id/tvFoodName"
                app:layout_constraintBottom_toBottomOf="@id/tvFoodName"
                app:layout_constraintEnd_toEndOf="parent"/>


            <TextView
                android:id="@+id/tvCountry"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="12dp"

                android:text=""

                android:textColor="@color/text_secondary"

                android:textSize="16sp"

                android:fontFamily="@font/inter"

                app:layout_constraintTop_toBottomOf="@id/ibHeart"
                app:layout_constraintStart_toStartOf="parent"/>


            <TextView
                android:id="@+id/tvCategory"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="12dp"

                android:text=""

                android:textColor="@color/text_secondary"

                android:textSize="16sp"

                android:fontFamily="@font/inter"

                app:layout_constraintTop_toBottomOf="@id/ibHeart"
                app:layout_constraintEnd_toEndOf="parent"/>


        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>





</androidx.cardview.widget.CardView>