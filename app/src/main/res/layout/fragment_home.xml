<?xml version="1.0" encoding="utf-8"?>

<ScrollView

    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/background"

    tools:context=".ui.fragments.HomeFragment">


    <androidx.constraintlayout.widget.ConstraintLayout

        android:layout_width="match_parent"

        android:layout_height="wrap_content"

        android:padding="20dp">


        <androidx.appcompat.widget.Toolbar

            android:id="@+id/toolBar"

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            app:layout_constraintTop_toTopOf="parent"

            app:layout_constraintStart_toStartOf="parent"

            app:layout_constraintEnd_toEndOf="parent">


            <TextView

                android:layout_width="wrap_content"

                android:layout_height="wrap_content"

                android:text="CookBook"

                android:textSize="50sp"

                android:textColor="@color/primary"

                android:fontFamily="@font/poppins_semibold"

                android:layout_gravity="center"/>


        </androidx.appcompat.widget.Toolbar>





        <TextView

            android:id="@+id/tvWelcome"

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:text="Welcome to CookBook!"

            android:textSize="30sp"

            android:textColor="@color/text_primary"

            android:fontFamily="@font/poppins_semibold"

            app:layout_constraintTop_toBottomOf="@id/toolBar"

            app:layout_constraintStart_toStartOf="parent"/>





        <TextView

            android:id="@+id/tvDescription"

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:text="Find your next favorite recipe"

            android:textSize="16sp"

            android:textColor="@color/text_secondary"

            android:fontFamily="@font/inter"

            app:layout_constraintTop_toBottomOf="@id/tvWelcome"

            app:layout_constraintStart_toStartOf="parent"/>





        <SearchView

            android:id="@+id/searchView"

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:queryHint="Search recipes..."

            android:searchHintIcon="@null"

            android:iconifiedByDefault="false"

            android:closeIcon="@drawable/outline_close_24"

            android:searchIcon="@drawable/baseline_search_24"

            android:focusable="false"

            android:background="@drawable/search_bkg"

            android:layout_marginTop="15dp"

            app:layout_constraintTop_toBottomOf="@id/tvDescription"

            app:layout_constraintStart_toStartOf="parent"

            app:layout_constraintEnd_toEndOf="parent"/>





        <TextView

            android:id="@+id/tvDice"

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:text="Roll the Dice🎲"

            android:textSize="25sp"

            android:textColor="@color/text_primary"

            android:fontFamily="@font/poppins_semibold"

            android:layout_marginTop="30dp"

            app:layout_constraintTop_toBottomOf="@id/searchView"

            app:layout_constraintStart_toStartOf="parent"/>





        <TextView

            android:id="@+id/tvDiceDescription"

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:text="Find your next favorite recipe"

            android:textSize="16sp"

            android:textColor="@color/text_secondary"

            android:fontFamily="@font/inter"

            app:layout_constraintTop_toBottomOf="@id/tvDice"

            app:layout_constraintStart_toStartOf="parent"/>





        <com.google.android.material.card.MaterialCardView

            android:id="@+id/cardDice"

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginTop="10dp"

            app:cardCornerRadius="18dp"

            android:backgroundTint="@color/card_background"

            app:layout_constraintTop_toBottomOf="@id/tvDiceDescription"

            app:layout_constraintStart_toStartOf="parent"

            app:layout_constraintEnd_toEndOf="parent">


            <com.airbnb.lottie.LottieAnimationView

                android:id="@+id/lottieAnimation"

                android:layout_width="match_parent"

                android:layout_height="300dp"

                app:lottie_autoPlay="false"

                app:lottie_loop="false"

                app:lottie_rawRes="@raw/dice_flip"/>


        </com.google.android.material.card.MaterialCardView>





        <TextView

            android:id="@+id/tvMadeForYou"

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:text="Made for You"

            android:textSize="25sp"

            android:textColor="@color/text_primary"

            android:fontFamily="@font/poppins_semibold"

            android:layout_marginTop="20dp"

            app:layout_constraintTop_toBottomOf="@id/cardDice"

            app:layout_constraintStart_toStartOf="parent"/>





        <TextView

            android:id="@+id/tvMadeDescription"

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:text="Based on your preferred cuisine"

            android:textSize="16sp"

            android:textColor="@color/text_secondary"

            android:fontFamily="@font/inter"

            app:layout_constraintTop_toBottomOf="@id/tvMadeForYou"

            app:layout_constraintStart_toStartOf="parent"/>



        <FrameLayout
            android:id="@+id/cuisineContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/tvMadeDescription"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.recyclerview.widget.RecyclerView

                android:id="@+id/rvMadeForYou"

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:layout_marginTop="20dp"

                android:nestedScrollingEnabled="false"

                tools:listitem="@layout/item_ingredients"
                android:visibility="gone"/>

            <com.google.android.material.card.MaterialCardView

                android:id="@+id/emptyCuisineCard"

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:layout_marginTop="20dp"

                app:cardCornerRadius="18dp"
                android:backgroundTint="@color/card_background"
                >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🗺️"
                        android:textSize="60sp"
                        android:textColor="@color/text_primary"
                        android:fontFamily="@font/inter"
                        />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No cuisine selected"
                        android:textSize="20sp"
                        android:textColor="@color/text_primary"
                        android:fontFamily="@font/poppins_semibold"
                        />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pick your favorite cuisines to get personalized recipe recommendations."
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:textAlignment="center"
                        android:fontFamily="@font/inter"
                        android:layout_marginBottom="10dp"
                        />
                    <TextView
                        android:id="@+id/selectedCuisine"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap to choose cuisines"
                        android:textSize="20sp"
                        android:textColor="@color/primary"
                        android:fontFamily="@font/poppins_semibold"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="30dp"
                        />

                </LinearLayout>


            </com.google.android.material.card.MaterialCardView>



        </FrameLayout>

        <TextView

            android:id="@+id/tvFav"

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:text="Cook with Chicken"

            android:textSize="25sp"

            android:textColor="@color/text_primary"

            android:fontFamily="@font/poppins_semibold"

            android:layout_marginTop="20dp"

            app:layout_constraintTop_toBottomOf="@id/cuisineContainer"

            app:layout_constraintStart_toStartOf="parent"/>





        <TextView

            android:id="@+id/tvFavDescription"

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:text="Based on your favorite ingredient"

            android:textSize="16sp"

            android:textColor="@color/text_secondary"

            android:fontFamily="@font/inter"

            app:layout_constraintTop_toBottomOf="@id/tvFav"

            app:layout_constraintStart_toStartOf="parent"/>





        <androidx.recyclerview.widget.RecyclerView

            android:id="@+id/rvFav"

            android:layout_width="0dp"

            android:layout_height="wrap_content"

            android:layout_marginTop="20dp"

            android:nestedScrollingEnabled="false"

            app:layout_constraintTop_toBottomOf="@id/tvFavDescription"

            app:layout_constraintStart_toStartOf="parent"

            app:layout_constraintEnd_toEndOf="parent"

            tools:listitem="@layout/item_favorites"/>





        <TextView

            android:id="@+id/tvExplore"

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:text="Explore Cuisines"

            android:textSize="25sp"

            android:textColor="@color/text_primary"

            android:fontFamily="@font/poppins_semibold"

            android:layout_marginTop="20dp"

            app:layout_constraintTop_toBottomOf="@id/rvFav"

            app:layout_constraintStart_toStartOf="parent"/>





        <androidx.recyclerview.widget.RecyclerView

            android:id="@+id/rvExplore"

            android:layout_width="0dp"

            android:layout_height="wrap_content"

            android:layout_marginTop="10dp"

            android:layout_marginBottom="20dp"

            app:layout_constraintTop_toBottomOf="@id/tvExplore"

            app:layout_constraintStart_toStartOf="parent"

            app:layout_constraintEnd_toEndOf="parent"

            app:layout_constraintBottom_toBottomOf="parent"

            tools:listitem="@layout/item_cuisines"/>


    </androidx.constraintlayout.widget.ConstraintLayout>


</ScrollView>