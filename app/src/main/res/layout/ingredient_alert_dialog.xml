<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/surface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/favorite_ingredient"
            android:textSize="30sp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/text_primary"
            android:layout_marginStart="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <RadioGroup
            android:id="@+id/radioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintBottom_toTopOf="@id/buttonCancel">

            <RadioButton
                android:id="@+id/rbEgg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/egg"
                android:tag="Egg"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/primary"
                android:layoutDirection="rtl"
                android:textDirection="ltr"/>

            <RadioButton
                android:id="@+id/rbBeef"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/beef"
                android:tag="Beef"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/primary"
                android:layoutDirection="rtl"
                android:textDirection="ltr"/>

            <RadioButton
                android:id="@+id/rbBread"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/bread"
                android:tag="Bread"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/primary"
                android:layoutDirection="rtl"
                android:textDirection="ltr"/>

            <RadioButton
                android:id="@+id/rbSugar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sugar"
                android:tag="Sugar"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/primary"
                android:layoutDirection="rtl"
                android:textDirection="ltr"/>

            <RadioButton
                android:id="@+id/rbCheese"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cheese"
                android:tag="Cheese"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/primary"
                android:layoutDirection="rtl"
                android:textDirection="ltr"/>

            <RadioButton
                android:id="@+id/rbCocoa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cocoa"
                android:tag="Cocoa"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/primary"
                android:layoutDirection="rtl"
                android:textDirection="ltr"/>

            <RadioButton
                android:id="@+id/rbMilk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/milk"
                android:tag="Milk"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/primary"
                android:layoutDirection="rtl"
                android:textDirection="ltr"/>

            <RadioButton
                android:id="@+id/rbHoney"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/honey"
                android:tag="Honey"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/primary"
                android:layoutDirection="rtl"
                android:textDirection="ltr"/>

            <RadioButton
                android:id="@+id/rbCarrots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/carrots"
                android:tag="Carrots"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/primary"
                android:layoutDirection="rtl"
                android:textDirection="ltr"/>

            <RadioButton
                android:id="@+id/rbCucumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cucumber"
                android:tag="Cucumber"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/primary"
                android:layoutDirection="rtl"
                android:textDirection="ltr"/>

        </RadioGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/primary"
            android:backgroundTint="@color/surface"
            app:cornerRadius="8dp"
            app:strokeColor="@color/primary"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/radioGroup"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/buttonSave"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="5dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/save"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/white"
            android:backgroundTint="@color/primary"
            app:cornerRadius="8dp"
            app:layout_constraintTop_toBottomOf="@id/radioGroup"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="5dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>