<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout

    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:padding="20dp"

    android:background="@color/background"

    tools:context=".ui.fragments.ProfileFragment">


    <TextView

        android:id="@+id/tvTitle"

        android:layout_width="wrap_content"

        android:layout_height="wrap_content"

        android:text="Profile"

        android:textColor="@color/primary"

        android:textSize="30sp"

        android:fontFamily="@font/poppins_semibold"

        app:layout_constraintTop_toTopOf="parent"

        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintEnd_toEndOf="parent"/>



    <ImageButton

        android:id="@+id/ibLogout"

        android:layout_width="40dp"

        android:layout_height="40dp"

        android:background="@android:color/transparent"

        android:src="@drawable/baseline_logout_24"

        android:contentDescription="Logout"

        android:foreground="?attr/selectableItemBackgroundBorderless"

        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintTop_toTopOf="parent"/>




    <com.google.android.material.imageview.ShapeableImageView

        android:id="@+id/imgProfilePhoto"

        android:layout_width="130dp"

        android:layout_height="130dp"

        android:layout_marginTop="10dp"

        android:padding="5dp"

        android:src="@drawable/baseline_person_24"

        android:scaleType="centerCrop"

        android:foreground="?attr/selectableItemBackgroundBorderless"

        app:shapeAppearance="@style/CircleImage"

        app:strokeWidth="3dp"

        app:strokeColor="@color/primary"

        app:layout_constraintTop_toBottomOf="@id/tvTitle"

        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintEnd_toEndOf="parent"/>




    <LinearLayout

        android:id="@+id/lLayoutInformation"

        android:layout_width="match_parent"

        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:gravity="center_horizontal"

        android:layout_marginTop="10dp"

        app:layout_constraintTop_toBottomOf="@id/imgProfilePhoto"

        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintEnd_toEndOf="parent">



        <TextView

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:text="Samed Tevin"

            android:textColor="@color/text_primary"

            android:fontFamily="@font/poppins_semibold"

            android:textSize="20sp"/>



        <TextView

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:text="\@username"

            android:textColor="@color/text_secondary"

            android:fontFamily="@font/inter"

            android:textSize="18sp"/>



        <TextView

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:text="samedtevin57@gmail.com"

            android:textColor="@color/text_secondary"

            android:fontFamily="@font/poppins_semibold"

            android:textSize="15sp"/>


    </LinearLayout>





    <TextView

        android:id="@+id/tvOptions"

        android:layout_width="wrap_content"

        android:layout_height="wrap_content"

        android:text="Account Options"

        android:textColor="@color/text_primary"

        android:fontFamily="@font/poppins_semibold"

        android:textSize="15sp"

        android:letterSpacing="0.08"

        android:layout_marginTop="10dp"

        app:layout_constraintTop_toBottomOf="@id/lLayoutInformation"

        app:layout_constraintStart_toStartOf="parent"/>




    <LinearLayout

        android:layout_width="match_parent"

        android:layout_height="wrap_content"

        android:orientation="vertical"

        app:layout_constraintTop_toBottomOf="@id/tvOptions"

        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintEnd_toEndOf="parent">



        <com.google.android.material.card.MaterialCardView

            android:id="@+id/editProfileCard"

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginTop="10dp"

            android:backgroundTint="@color/card_background"

            android:clickable="true"

            android:focusable="true"

            app:cardCornerRadius="16dp"

            app:cardElevation="4dp">



            <LinearLayout

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:orientation="horizontal"

                android:gravity="center_vertical"

                android:padding="16dp">



                <ImageView

                    android:layout_width="24dp"

                    android:layout_height="24dp"

                    android:src="@drawable/baseline_person_24"/>



                <TextView

                    android:layout_width="0dp"

                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:layout_marginStart="16dp"

                    android:text="Edit Profile"

                    android:textColor="@color/text_primary"

                    android:textSize="16sp"/>



                <ImageView

                    android:layout_width="20dp"

                    android:layout_height="20dp"

                    android:src="@drawable/outline_chevron_right_24"/>


            </LinearLayout>


        </com.google.android.material.card.MaterialCardView>





        <com.google.android.material.card.MaterialCardView

            android:id="@+id/languageCard"

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginTop="10dp"

            android:backgroundTint="@color/card_background"

            android:clickable="true"

            android:focusable="true"

            app:cardCornerRadius="16dp"

            app:cardElevation="4dp">



            <LinearLayout

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:orientation="horizontal"

                android:gravity="center_vertical"

                android:padding="16dp">



                <ImageView

                    android:layout_width="24dp"

                    android:layout_height="24dp"

                    android:src="@drawable/language"/>



                <TextView

                    android:layout_width="0dp"

                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:layout_marginStart="16dp"

                    android:text="Language"

                    android:textColor="@color/text_primary"

                    android:textSize="16sp"/>



                <TextView

                    android:id="@+id/selectedLanguage"

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"

                    android:text="English"

                    android:textColor="@color/text_secondary"/>



                <ImageView

                    android:layout_width="20dp"

                    android:layout_height="20dp"

                    android:src="@drawable/outline_chevron_right_24"/>


            </LinearLayout>


        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView

            android:id="@+id/darkModeCard"

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginTop="10dp"

            android:backgroundTint="@color/card_background"

            app:cardCornerRadius="16dp"

            app:cardElevation="4dp">



            <LinearLayout

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:orientation="horizontal"

                android:gravity="center_vertical"

                android:padding="16dp">



                <ImageView

                    android:layout_width="24dp"

                    android:layout_height="24dp"

                    android:src="@drawable/baseline_dark_mode_24"/>



                <TextView

                    android:layout_width="0dp"

                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:layout_marginStart="16dp"

                    android:text="Dark Mode"

                    android:textColor="@color/text_primary"

                    android:textSize="16sp"/>



                <com.google.android.material.materialswitch.MaterialSwitch

                    android:id="@+id/switchDarkMode"

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"/>


            </LinearLayout>


        </com.google.android.material.card.MaterialCardView>





        <com.google.android.material.card.MaterialCardView

            android:id="@+id/cuisineCard"

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginTop="10dp"

            android:backgroundTint="@color/card_background"

            android:clickable="true"

            android:focusable="true"

            app:cardCornerRadius="16dp"

            app:cardElevation="4dp">



            <LinearLayout

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:orientation="horizontal"

                android:gravity="center_vertical"

                android:padding="16dp">



                <ImageView

                    android:layout_width="24dp"

                    android:layout_height="24dp"

                    android:src="@drawable/outline_restaurant_24"/>



                <TextView

                    android:layout_width="0dp"

                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:layout_marginStart="16dp"

                    android:text="Preferred Cuisine"

                    android:textColor="@color/text_primary"

                    android:textSize="16sp"/>



                <TextView

                    android:id="@+id/selectedCuisine"

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"

                    android:text="Turkish"

                    android:textColor="@color/text_secondary"/>



                <ImageView

                    android:layout_width="20dp"

                    android:layout_height="20dp"

                    android:src="@drawable/outline_chevron_right_24"/>


            </LinearLayout>


        </com.google.android.material.card.MaterialCardView>





        <com.google.android.material.card.MaterialCardView

            android:id="@+id/ingredientCard"

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginTop="10dp"

            android:backgroundTint="@color/card_background"

            android:clickable="true"

            android:focusable="true"

            app:cardCornerRadius="16dp"

            app:cardElevation="4dp">



            <LinearLayout

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:orientation="horizontal"

                android:gravity="center_vertical"

                android:padding="16dp">



                <ImageView

                    android:layout_width="24dp"

                    android:layout_height="24dp"

                    android:src="@drawable/outline_local_dining_24"/>



                <TextView

                    android:layout_width="0dp"

                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:layout_marginStart="16dp"

                    android:text="Favorite Ingredient"

                    android:textColor="@color/text_primary"

                    android:textSize="16sp"/>



                <TextView

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"

                    android:text="Chicken"

                    android:textColor="@color/text_secondary"/>



                <ImageView

                    android:id="@+id/selectedIngredient"

                    android:layout_width="20dp"

                    android:layout_height="20dp"

                    android:src="@drawable/outline_chevron_right_24"/>


            </LinearLayout>


        </com.google.android.material.card.MaterialCardView>





        <com.google.android.material.card.MaterialCardView

            android:id="@+id/aboutCard"

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginTop="10dp"

            android:backgroundTint="@color/card_background"

            android:clickable="true"

            android:focusable="true"

            app:cardCornerRadius="16dp"

            app:cardElevation="4dp">



            <LinearLayout

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:orientation="horizontal"

                android:gravity="center_vertical"

                android:padding="16dp">



                <ImageView

                    android:layout_width="24dp"

                    android:layout_height="24dp"

                    android:src="@drawable/baseline_info_24"/>



                <LinearLayout

                    android:layout_width="0dp"

                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:orientation="vertical">



                    <TextView

                        android:layout_width="wrap_content"

                        android:layout_height="wrap_content"

                        android:layout_marginStart="16dp"

                        android:text="About"

                        android:textColor="@color/text_primary"

                        android:textSize="16sp"/>



                    <TextView

                        android:layout_width="wrap_content"

                        android:layout_height="wrap_content"

                        android:layout_marginStart="16dp"

                        android:text="Version 2.4.0"

                        android:textColor="@color/text_secondary"

                        android:textSize="12sp"/>


                </LinearLayout>



                <ImageView

                    android:layout_width="20dp"

                    android:layout_height="20dp"

                    android:src="@drawable/outline_chevron_right_24"/>


            </LinearLayout>


        </com.google.android.material.card.MaterialCardView>


    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>